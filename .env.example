# 将此文件复制为 .env，填写你自己的 API Key；不要提交 .env。
MODEL_API_KEY=your_api_key_here
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com

# 如果改用其他 OpenAI 兼容模型，请同步调整 MODEL_NAME 和 MODEL_BASE_URL。

# ---- RAG 检索（向量后端）----
# 检索后端：vector（默认，LlamaIndex + Chroma 本地向量库）或 lexical（离线词法倒排兜底）
# RAG_BACKEND=vector
# embedding 提供方：fastembed（默认，本地免费模型，首次运行自动从 HuggingFace 下载约 100MB；
# 网络受限时可设 HF_ENDPOINT=https://hf-mirror.com 走镜像）或 openai（OpenAI 兼容 API）
# RAG_EMBEDDING_PROVIDER=fastembed
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 仅 RAG_EMBEDDING_PROVIDER=openai 时需要以下三项（注意 DeepSeek 没有 embedding 接口，
# 需另配支持 embedding 的服务，如官方 OpenAI、DashScope、SiliconFlow 等）：
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_MODEL=text-embedding-3-small
